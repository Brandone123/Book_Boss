{
  "expo": {
    "name": "koach-books",
    "slug": "koach-books",
    "newArchEnabled": "true",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#666666"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "This application will access your photos..."
        }
      ]
    ],
    "extra": {
      "API_BASE_URL": "http://localhost:8081"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}