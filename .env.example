# Copiez ce fichier vers .env et modifiez les valeurs selon votre environnement

# URL de l'API - Important de choisir la bonne selon votre environnement
# ---------------------------------------------------------------------
# Pour iOS Simulator: API_BASE_URL="http://localhost:8081"
# Pour Android Emulator: API_BASE_URL="http://10.0.2.2:8081"
# Pour les appareils physiques: Utilisez votre adresse IP locale
#   Exemple: API_BASE_URL="http://192.168.1.100:8081"

# Configuration par défaut pour le développement local
API_BASE_URL="http://localhost:8081" 